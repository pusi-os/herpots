# Zhengchen 1.54" TFT WiFi "zhengchen-154": ESP32-S3R8 (16 MB flash, 8 MB
# octal PSRAM), 1.54" 240x240 ST7789 over SPI, raw-I2S MEMS microphone, raw-I2S
# speaker amp, BOOT=TALK (GPIO0), VOL+ (10) / VOL- (39), rail hold on GPIO2.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# No USB-JTAG on this board: the port is a CH340 UART bridge, so the console
# stays on UART0 (the build default) and flashing is UART only.
CONFIG_HG_BOARD_ZHENGCHEN_154=y

# Same TCP window set as the cube (Wi-Fi link with real round trip):
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
