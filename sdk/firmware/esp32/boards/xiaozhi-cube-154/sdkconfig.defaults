# Xiaozhi AI cube "xiaozhi-cube-154": ESP32-S3R8 (16 MB flash, 8 MB octal PSRAM),
# 1.54" 240x240 ST7789 over SPI, raw-I2S MEMS microphone, raw-I2S speaker amp,
# BOOT=TALK (GPIO0), VOL+ (40) / VOL- (39), power latch on GPIO21.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# Console on the S3's own USB Serial/JTAG (the USB-C port): the cube has no
# UART0 header, and the base defaults leave input on UART0 GPIO44/43.
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_HG_BOARD_XIAOZHI_CUBE_154=y

# Same TCP window set as the breadboard (Wi-Fi link with real round trip):
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
